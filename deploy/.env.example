# =============================================================================
# Yanki environment — EXAMPLE / TEMPLATE (placeholders only).
#
#   Copy to deploy/.env and fill in real values:   cp deploy/.env.example deploy/.env
#
#   *** NEVER COMMIT REAL SECRETS ***
#   deploy/.env is gitignored. Only this .env.example (placeholders) is tracked.
#   docker compose reads deploy/.env via `env_file`.
# =============================================================================

# --- Run mode ---------------------------------------------------------------
# 1 = run the whole pipeline on deterministic MOCK search/LLM ($0, no keys).
# 0 = call OpenRouter + Tavily (requires the keys below).
DRY_RUN=1

# --- Measured GEO keys (OpenRouter LLM + Tavily search) ---------------------
# Leave blank when DRY_RUN=1. Required only when DRY_RUN=0.
OPEN_ROUTER_KEY=
TAVILY_API_KEY=
# OpenRouter model id for KYC + grounded answer + audit extraction.
OPENROUTER_MODEL=openai/gpt-4o-mini
# measured = Tavily search + grounded answer (needs TAVILY_API_KEY when DRY_RUN=0)
# simulated = OpenRouter-only SYSTEM_PROMPT path (no Tavily)
GEO_MODE=measured
# Dollars per Tavily search, counted into responses.cost_usd (and therefore into
# CHECKER_DAILY_USD_CAP and the M1 credit ledger). Tavily bills in plan-dependent
# API credits that the app cannot read, so this is a PINNED ESTIMATE, set high on
# purpose — an over-estimate makes a cost cap fail safe. Correct it here once a
# real invoice exists. OpenRouter reports its own cost per call and needs no pin.
TAVILY_SEARCH_USD=0.008

# --- Backlink Intelligence (Phase 8 / M2) -----------------------------------
# OFF by default and dark until a vendor and budget are chosen (operator A4).
# While off, nothing runs; while on under DRY_RUN=1 the module runs end-to-end
# on a deterministic mock at $0. An unrecognised vendor is reported as "not
# measured" rather than silently falling back to fixtures that look like data.
BACKLINKS_ENABLED=0
BACKLINK_VENDOR=mock

# --- Site Audit enqueue (M3) ------------------------------------------------
# OFF by default. No deployed service drains the site-audit queue (the `worker`
# consumes the GEO analyses queue, not this one), so a queued crawl would sit
# `queued` forever. While off, the two routes that start a crawl are refused 404
# the same way the backlink module goes dark; reads of existing projects and
# audits stay open. Turn on ONLY once a Chromium audit worker ships with egress
# and settings isolation — see docs/site-audit-integration.md.
SITE_AUDIT_ENABLED=0

# --- Legacy multi-engine panel keys (unused by measured path) ---------------
# Kept for transitional DRY_RUN panel tests; not required for measured GEO.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# --- Database ---------------------------------------------------------------
# Postgres password for the db container (used in prod; dev uses "yanki").
POSTGRES_PASSWORD=change-me-in-prod
# SQLAlchemy URL. In docker compose the api/worker get this injected for you;
# set it here only when running the backend directly on the host.
DATABASE_URL=postgresql+psycopg://yanki:yanki@localhost:5432/yanki

# --- Authentication / JWT ---------------------------------------------------
# Secret used to sign access and refresh JWTs. Generate the production value:
#
#   openssl rand -hex 32
#
# Keep the real value only in deploy/.env. Never commit it.
# The API will refuse to issue or validate tokens while this is blank
# (or shorter than 32 bytes) — login returns 503 authentication unavailable.
JWT_SECRET_KEY=
JWT_ISSUER=yanki-api
JWT_AUDIENCE=yanki-web

# Short-lived bearer token returned in the login/refresh response.
JWT_ACCESS_TOKEN_MINUTES=15

# Maximum lifetime of one refresh-token family. Rotation does not extend this.
JWT_REFRESH_TOKEN_DAYS=30

# Small tolerance for host clock differences while checking iat/nbf/exp.
JWT_CLOCK_SKEW_SECONDS=30

# Refresh token is stored only in this HttpOnly cookie.
AUTH_REFRESH_COOKIE_NAME=yanki_refresh_token

# Production must remain 1. Local HTTP development can set 0.
AUTH_REFRESH_COOKIE_SECURE=1

# --- Sign in with Google / Apple --------------------------------------------
# The OAuth client id of THIS application, from the Google Cloud console and
# from Apple's Services ID. Not a secret — the browser sends it too — but it is
# the audience an incoming identity token must name, so a wrong value rejects
# every sign-in and a blank one disables that provider (503, never a silent
# accept). No client secret is needed: the browser completes the sign-in and the
# API only verifies the resulting token's signature.
#
# Google: create an OAuth 2.0 Client ID of type "Web application" and add the
# exact frontend origin (for example https://app.example.com, with no trailing
# slash) under Authorized JavaScript origins. Popup mode does not need a Google
# redirect URI.
#
# Apple: use the Services ID identifier as APPLE_CLIENT_ID, enable "Sign in with
# Apple" for it, and register the frontend domain plus the exact frontend origin
# as its Return URL. The browser passes window.location.origin to Apple, so the
# scheme, host and port must match the registered value exactly. Apple does not
# accept localhost as a Return URL; local end-to-end testing therefore needs an
# HTTPS development domain or tunnel that is also registered in the Services ID.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- Pipeline / cost controls -----------------------------------------------
PROMPT_COUNT=10
PANEL_ENGINES=anthropic,openai,gemini,perplexity
MAX_RESPONSES_PER_JOB=60

# --- Plan quota enforcement (P7.6 / ADR-45) ---------------------------------
# ON by default, unlike every other flag in this file — a plan tier nothing
# enforces is decorative, which is what this exists to stop being true. It is a
# kill switch, not a feature gate: set it to 0 and no quota is counted or
# refused anywhere, while RBAC, the per-IP rate limits and the checker's daily
# USD cap are all untouched.
#
# What ON means in practice: an organization with no subscription row falls back
# to **Free** — 5 analyses a month, 1 site audit, 1 project. Every organization
# in production is in that state today, because nothing has ever created a
# subscription. To lift one:
#
#   docker exec yanki-prod-api-1 python /app/scripts/set_org_plan.py --list
#   docker exec yanki-prod-api-1 python /app/scripts/set_org_plan.py \
#       --org <slug-or-uuid> --set enterprise
QUOTA_ENFORCEMENT_ENABLED=1

# --- Rate limiting (POST /api/v1/analyses) ----------------------------------
# The submit endpoint requires authentication (ADR-45); these stay as defence in
# depth and reject before any row is created or money is spent. They bound one
# credential's burst, which a monthly plan allowance does not.
# Max submits per client IP per rolling hour (429 + Retry-After over this).
# 0 is a kill-switch: every submit is rejected 429 (no crash, no spend).
ANALYSES_RATE_LIMIT_PER_IP_HOUR=5
# Global backstop: max submits across ALL IPs per rolling 24h. 0 = kill-switch.
ANALYSES_DAILY_CAP=100
# Salt mixed into the stored ip_hash (sha256(salt+ip)); blank is fine for MVP.
IP_HASH_SALT=

# --- Checker (POST /api/v1/checker) -----------------------------------------
# A fresh checker run is reused for this many hours when a done analysis with
# the same normalized (brand, category, lang) exists, so a hot brand costs $0
# on repeat and can't be hammered into new LLM spend.
CHECKER_RESULT_CACHE_HOURS=24

# --- Checker public hardening (POST /api/v1/checker) — P5.6 ------------------
# The checker is anonymous and, with real keys, LLM-spending. These guards run
# BEFORE enqueuing; a $0 24h cache hit is exempt from all of them (it must still
# return its id so the email gate can attach a lead). The stored ip_hash reuses
# IP_HASH_SALT above — there is no separate checker salt.
#
# Master kill-switch. 0 = OFF (default): a FRESH submit is parked with a friendly
# 503 and records nothing; a 24h cached-brand hit still returns (it costs $0).
# The operator flips this to 1 at P5.11 go-live — the public surface stays dark
# in every environment until then.
CHECKER_ENABLED=0
# Max checker submissions per client IP per rolling hour (429 + Retry-After over
# this). 0 = kill-switch (rejects every fresh submit), same idiom as the
# analyses caps above.
CHECKER_RATE_LIMIT_PER_IP_HOUR=10
# Max FRESH runs of one normalized (brand, category, lang) per rolling day (429
# over this) — bounds one hot brand hammered from many IPs. A cache-served
# repeat is not a fresh run and never counts. 0 = kill-switch.
CHECKER_RATE_LIMIT_PER_BRAND_DAY=20
# Daily USD cap on summed checker cost (rolling 24h). At/over it a fresh run is
# refused with a friendly at-capacity 503; cached hits still return. Under
# DRY_RUN every cost is 0, so any positive cap never trips.
CHECKER_DAILY_USD_CAP=5.0

# --- SERP visibility (open-source metasearch) — ADR-28 -----------------------
# Reads an operator-run SearXNG instance to see whether the company also shows
# up in ORDINARY search results, alongside the AI-answer GEO score. No vendor and
# no per-query bill: SearXNG is open source and you run it.
#
# Master switch. 0 = OFF (default): no searches run, and every serp_* column
# stays NULL — which reads as "not measured", never as "measured zero".
SERP_ENABLED=0
# Starts the bundled SearXNG service (ADR-29). The compose files put it behind
# the `serp` profile, and compose reads COMPOSE_PROFILES from THIS file, so this
# one line is the whole opt-in — deployment.sh needs no change. Leave it unset
# and no search container is ever created.
#   COMPOSE_PROFILES=serp
# Turning SERP on therefore means three lines here: COMPOSE_PROFILES=serp,
# SERP_ENABLED=1, and the SERP_BASE_URL below. It also needs
# deploy/searxng/settings.yml to exist on the host — create it from
# deploy/searxng/settings.example.yml (it carries a real secret_key, so it is
# gitignored exactly like this file).
# Base URL of your SearXNG instance, e.g. http://searxng:8080 on the compose
# network. Two things bite here, both silent:
#   * the JSON format is OFF by default in SearXNG. Without
#       search:
#         formats: [html, json]
#     in its settings.yml it serves the HTML results page and every run reports
#     "the search instance did not return JSON".
#   * its `limiter` answers 403 to a bot-shaped client.
# A PUBLIC instance is not a suitable target: most disable the JSON format, and
# pointing production traffic at a volunteer's box is both rude and unreliable.
# With the bundled service above, the right value is the compose-network name:
#   SERP_BASE_URL=http://searxng:8080
SERP_BASE_URL=
# Searches per analysis. Each is one HTTP call to YOUR instance, so this is a
# politeness/latency budget, not a cost cap.
SERP_QUERY_COUNT=6
SERP_TIMEOUT_SECONDS=10.0
# Pinned rather than left to the instance: a metasearch instance geolocates by
# its own egress IP, so an unpinned language quietly makes two deployments'
# numbers incomparable.
SERP_LANGUAGE=en
SERP_CATEGORIES=general
# Optional comma-separated engine allowlist passed straight through to the
# instance; blank means "whatever it has enabled".
SERP_ENGINES=
SERP_SAFESEARCH=0
SERP_MAX_RESULTS=20

# --- Keyword research preview (docs/keyword-preview-oss.md) ----------------
# Expand seeds via the same SearXNG instance as SERP (SERP_BASE_URL above).
# Default OFF. Under DRY_RUN=1 the path uses a mock source so CI needs no
# instance; live/product preview uses SearXNG (not mock).
KEYWORD_ENABLED=0
KEYWORD_MAX_IDEAS=50
KEYWORD_VARIANT_MAX=3
KEYWORD_RANK_MAX_QUERIES=10
# Google Ads Keyword Planning metrics (volume). Keep 0 until credentials work.
KEYWORD_ADS_ENABLED=0
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Digits only (no dashes). Client account for Keyword Planning lookups.
GOOGLE_ADS_CUSTOMER_ID=
# Digits only. MCC / manager id when using a manager account (login-customer-id).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Transactional email (Resend REST API) — P5.13 --------------------------
# Waitlist thank-you/notification mail + terminal-status run alerts go through
# Resend over plain httpx (no SDK). Fail-open + env-gated: send is a NO-OP unless
# EMAILS_ENABLED=1 AND RESEND_API_KEY is non-empty, and it never raises — a
# recorded signup/run is never lost to a mail failure.
#
# Master switch. 0 = OFF (default): no environment sends mail until you opt in.
EMAILS_ENABLED=0
# Resend API key (Bearer). Leave blank to keep email a no-op even if enabled.
RESEND_API_KEY=
# Operator address for new-signup + run alerts. Blank = those alerts are skipped.
NOTIFY_EMAIL=
# From address. MUST be a Resend-VERIFIED domain before real recipients get mail:
# the default onboarding@resend.dev is Resend "testing mode" and delivers ONLY to
# the Resend account owner, never to arbitrary recipients.
EMAIL_FROM=onboarding@resend.dev

# --- Admin Panel: invitations (P7.4) ----------------------------------------
# Where this deployment is reachable FROM A BROWSER. It is the only thing the
# API cannot infer from the request that carries it — the request arrives at the
# internal container, not at the public origin — and it is what invitation links
# are built from. Get it wrong and every invitation email points somewhere that
# does not serve this app.
#
# Dev default matches the dev web port; prod must be the public URL.
PUBLIC_BASE_URL=http://localhost:8140
# How long an invitation link stays usable, in days (1-90). Long enough to
# survive a holiday, short enough that a forgotten invitation is not a permanent
# standing grant sitting in somebody's inbox.
INVITATION_TTL_DAYS=14

# --- Worker -----------------------------------------------------------------
WORKER_POLL_SECONDS=2
STALE_CLAIM_SECONDS=300

# --- Site Audit worker --------------------------------------------------------
# Site Audit runs on its own worker (the audit-worker service) and its own queue,
# separate from the GEO pipeline worker above. Every value below has a safe
# default matching backend/app/config.py — these lines only need uncommenting
# when a deployment wants to tune crawl behaviour. Values are read directly by
# the audit-worker container's environment, not baked into the image, so
# changing them here never invalidates the Docker build cache.
#
# How often the worker polls the queue for a new audit job.
SITE_AUDIT_WORKER_POLL_SECONDS=2
# A 'running' audit whose claim is older than this is treated as abandoned (a
# crashed worker) and picked up again. Longer than the GEO worker's because a
# browser crawl heartbeats only after each persisted page, not continuously.
SITE_AUDIT_STALE_CLAIM_SECONDS=900
# Max time a single page navigation (page.goto) is allowed to take.
SITE_AUDIT_PAGE_TIMEOUT_MS=30000
# Extra wait after navigation before reading the rendered DOM, when JS
# rendering is enabled for the audit.
SITE_AUDIT_RENDER_WAIT_MS=1500
# Politeness delay between page fetches (also compared against the target
# site's own robots.txt Crawl-delay, whichever is larger wins).
SITE_AUDIT_CRAWL_DELAY_SECONDS=0.25
# Byte cap while streaming a robots.txt response.
SITE_AUDIT_MAX_ROBOTS_BYTES=512000
# Max URLs read out of a site's sitemap(s) per audit.
SITE_AUDIT_SITEMAP_URL_LIMIT=1000
# Byte cap per individual sitemap file fetched.
SITE_AUDIT_MAX_SITEMAP_BYTES=5000000
# Max characters of HTML kept per crawled page before analysis.
SITE_AUDIT_MAX_HTML_CHARS=2000000
# Max total URLs the crawl frontier will track (visited + queued) per audit.
SITE_AUDIT_MAX_QUEUE_URLS=5000
# Upper bound on the politeness delay while navigations keep failing in a row.
# Never drops below the robots.txt/politeness delay above; it only grows.
SITE_AUDIT_FAILURE_BACKOFF_MAX_SECONDS=10
# Stop the crawl after this many consecutive failed navigations — past that the
# page budget only buys timeouts against a target that stopped answering.
# Set to 0 to crawl the whole budget regardless.
SITE_AUDIT_MAX_CONSECUTIVE_FAILURES=10

# --- Dev host ports (deploy/docker-compose.yml only) ------------------------
# Host-side published ports for `make dev` / the dev compose file. Change these
# if the defaults collide with something already running on your machine
# (container-internal ports and inter-container URLs are unaffected).
YANKI_DB_PORT=5432
YANKI_API_PORT=8141
YANKI_WEB_PORT=8140

# --- Prod host ports (deploy/docker-compose.prod.yml only) -------------------
# Loopback binds used ONLY by deploy.sh health checks / local debugging — the
# shared Caddy reaches the containers over the docker network aliases
# yanki-web / yanki-api, not these. Defaults dodge ports already in use on the
# beyondkaira VPS: 8140 belongs to another tenant, and 8141 is the dev stack's
# api default on the same box.
YANKI_PROD_WEB_PORT=8142
YANKI_PROD_API_PORT=8143
