          "matched_via",
          "result_count",
          "unresponsive_engines"
        ],
        "title": "SerpCheckOut",
        "type": "object"
      },
      "SerpVisibilityOut": {
        "description": "SERP visibility for one analysis (ADR-28).\n\nPresent only on runs where the feature was switched on; ``ResultOut.serp``\nstays null otherwise, so \"we did not look\" is never rendered as a zero.\n``score`` is separately nullable *within* a present summary: that is the run\nwhere we did look and could not read the results.",
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/SerpCheckOut"
            },
            "title": "Checks",
            "type": "array"
          },
          "hits": {
            "title": "Hits",
            "type": "integer"
          },
          "queries": {
            "title": "Queries",
            "type": "integer"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "source",
          "score",
          "hits",
          "queries",
          "checks"
        ],
        "title": "SerpVisibilityOut",
        "type": "object"
      },
      "SignupRequest": {
        "description": "Credentials required to create a user account.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignupRequest",
        "type": "object"
      },
      "UserOut": {
        "description": "Public user fields returned by authentication endpoints.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "created_at"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WaitlistRequest": {
        "description": "A public waitlist signup. The email is validated + normalized server-side\n(trim + lowercase) so a malformed address is a 422 before any row is written,\nand the stored value matches the unique lowercased column.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "WaitlistRequest",
        "type": "object"
      },
      "WaitlistResponse": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "WaitlistResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
