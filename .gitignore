# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / Next.js ---------------------------------------------------------
node_modules/
.next/

# --- Playwright artifacts ---------------------------------------------------
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Environment files (NEVER commit real secrets) --------------------------
# Only the *.example templates are tracked.
.env
.env.*
deploy/.env
!.env.example
!deploy/.env.example
# The SearXNG instance config carries a real secret_key, so it lives on the host
# beside deploy/.env and only the template is tracked.
deploy/searxng/settings.yml
!deploy/searxng/settings.example.yml

# --- Local deploy state -----------------------------------------------------
deploy/.last-good

# --- Database dumps ---------------------------------------------------------
# `deploy/backup.sh` writes to ~/yanki-backups, outside the repo, so this is
# belt-and-braces for the case where somebody points YANKI_BACKUP_DIR at the
# working tree. A dump is the entire database in one file — password hashes,
# email addresses, audit payloads — and this repository is public.
*.dump
*.dump.partial

# --- Misc -------------------------------------------------------------------
.claude/scheduled_tasks.lock
*.log
.DS_Store
