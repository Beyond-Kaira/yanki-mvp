# =============================================================================
# Yanki environment — EXAMPLE / TEMPLATE (placeholders only).
#
#   Copy to deploy/.env and fill in real values:   cp deploy/.env.example deploy/.env
#
#   *** NEVER COMMIT REAL SECRETS ***
#   deploy/.env is gitignored. Only this .env.example (placeholders) is tracked.
#   docker compose reads deploy/.env via `env_file`.
# =============================================================================

# --- Run mode ---------------------------------------------------------------
# 1 = run the whole pipeline on a deterministic MOCK provider ($0, no keys).
# 0 = call the real providers (requires the API keys below).
DRY_RUN=1

# --- LLM provider keys ------------------------------------------------------
# Leave blank when DRY_RUN=1. Required only when DRY_RUN=0.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini + Perplexity (P5.7 — real 4-engine panel). Required only when DRY_RUN=0;
# leave blank under DRY_RUN=1. The real REST adapters (Gemini generateContent with
# Google Search grounding, Perplexity sonar) read these when DRY_RUN=0; under
# DRY_RUN=1 the panel is four mocks and neither key is ever read or called.
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# --- Database ---------------------------------------------------------------
# Postgres password for the db container (used in prod; dev uses "yanki").
POSTGRES_PASSWORD=change-me-in-prod
# SQLAlchemy URL. In docker compose the api/worker get this injected for you;
# set it here only when running the backend directly on the host.
DATABASE_URL=postgresql+psycopg://yanki:yanki@localhost:5432/yanki

# --- Authentication / JWT ---------------------------------------------------
# Secret used to sign access and refresh JWTs. Generate the production value:
#
#   openssl rand -hex 32
#
# Keep the real value only in deploy/.env. Never commit it.
# The API will refuse to issue or validate tokens while this is blank.
JWT_SECRET_KEY=
JWT_ISSUER=yanki-api
JWT_AUDIENCE=yanki-web

# Short-lived bearer token returned in the login/refresh response.
JWT_ACCESS_TOKEN_MINUTES=15

# Maximum lifetime of one refresh-token family. Rotation does not extend this.
JWT_REFRESH_TOKEN_DAYS=30

# Small tolerance for host clock differences while checking iat/nbf/exp.
JWT_CLOCK_SKEW_SECONDS=30

# Refresh token is stored only in this HttpOnly cookie.
AUTH_REFRESH_COOKIE_NAME=yanki_refresh_token

# Production must remain 1. Local HTTP development will override it explicitly.
AUTH_REFRESH_COOKIE_SECURE=1

# --- Pipeline / cost controls -----------------------------------------------
PROMPT_COUNT=10
PANEL_ENGINES=anthropic,openai,gemini,perplexity
MAX_RESPONSES_PER_JOB=60

# --- Rate limiting (POST /api/v1/analyses) ----------------------------------
# The submit endpoint is public with real keys; these reject before any row is
# created or money is spent.
# Max submits per client IP per rolling hour (429 + Retry-After over this).
# 0 is a kill-switch: every submit is rejected 429 (no crash, no spend).
ANALYSES_RATE_LIMIT_PER_IP_HOUR=5
# Global backstop: max submits across ALL IPs per rolling 24h. 0 = kill-switch.
ANALYSES_DAILY_CAP=100
# Salt mixed into the stored ip_hash (sha256(salt+ip)); blank is fine for MVP.
IP_HASH_SALT=

# --- Checker (POST /api/v1/checker) -----------------------------------------
# A fresh checker run is reused for this many hours when a done analysis with
# the same normalized (brand, category, lang) exists, so a hot brand costs $0
# on repeat and can't be hammered into new LLM spend.
CHECKER_RESULT_CACHE_HOURS=24

# --- Checker public hardening (POST /api/v1/checker) — P5.6 ------------------
# The checker is anonymous and, with real keys, LLM-spending. These guards run
# BEFORE enqueuing; a $0 24h cache hit is exempt from all of them (it must still
# return its id so the email gate can attach a lead). The stored ip_hash reuses
# IP_HASH_SALT above — there is no separate checker salt.
#
# Master kill-switch. 0 = OFF (default): a FRESH submit is parked with a friendly
# 503 and records nothing; a 24h cached-brand hit still returns (it costs $0).
# The operator flips this to 1 at P5.11 go-live — the public surface stays dark
# in every environment until then.
CHECKER_ENABLED=0
# Max checker submissions per client IP per rolling hour (429 + Retry-After over
# this). 0 = kill-switch (rejects every fresh submit), same idiom as the
# analyses caps above.
CHECKER_RATE_LIMIT_PER_IP_HOUR=10
# Max FRESH runs of one normalized (brand, category, lang) per rolling day (429
# over this) — bounds one hot brand hammered from many IPs. A cache-served
# repeat is not a fresh run and never counts. 0 = kill-switch.
CHECKER_RATE_LIMIT_PER_BRAND_DAY=20
# Daily USD cap on summed checker cost (rolling 24h). At/over it a fresh run is
# refused with a friendly at-capacity 503; cached hits still return. Under
# DRY_RUN every cost is 0, so any positive cap never trips.
CHECKER_DAILY_USD_CAP=5.0

# --- SERP visibility (open-source metasearch) — ADR-28 -----------------------
# Reads an operator-run SearXNG instance to see whether the company also shows
# up in ORDINARY search results, alongside the AI-answer GEO score. No vendor and
# no per-query bill: SearXNG is open source and you run it.
#
# Master switch. 0 = OFF (default): no searches run, and every serp_* column
# stays NULL — which reads as "not measured", never as "measured zero".
SERP_ENABLED=0
# Starts the bundled SearXNG service (ADR-29). The compose files put it behind
# the `serp` profile, and compose reads COMPOSE_PROFILES from THIS file, so this
# one line is the whole opt-in — deployment.sh needs no change. Leave it unset
# and no search container is ever created.
#   COMPOSE_PROFILES=serp
# Turning SERP on therefore means three lines here: COMPOSE_PROFILES=serp,
# SERP_ENABLED=1, and the SERP_BASE_URL below. It also needs
# deploy/searxng/settings.yml to exist on the host — create it from
# deploy/searxng/settings.example.yml (it carries a real secret_key, so it is
# gitignored exactly like this file).
# Base URL of your SearXNG instance, e.g. http://searxng:8080 on the compose
# network. Two things bite here, both silent:
#   * the JSON format is OFF by default in SearXNG. Without
#       search:
#         formats: [html, json]
#     in its settings.yml it serves the HTML results page and every run reports
#     "the search instance did not return JSON".
#   * its `limiter` answers 403 to a bot-shaped client.
# A PUBLIC instance is not a suitable target: most disable the JSON format, and
# pointing production traffic at a volunteer's box is both rude and unreliable.
# With the bundled service above, the right value is the compose-network name:
#   SERP_BASE_URL=http://searxng:8080
SERP_BASE_URL=
# Searches per analysis. Each is one HTTP call to YOUR instance, so this is a
# politeness/latency budget, not a cost cap.
SERP_QUERY_COUNT=6
SERP_TIMEOUT_SECONDS=10.0
# Pinned rather than left to the instance: a metasearch instance geolocates by
# its own egress IP, so an unpinned language quietly makes two deployments'
# numbers incomparable.
SERP_LANGUAGE=en
SERP_CATEGORIES=general
# Optional comma-separated engine allowlist passed straight through to the
# instance; blank means "whatever it has enabled".
SERP_ENGINES=
SERP_SAFESEARCH=0
SERP_MAX_RESULTS=20

# --- Transactional email (Resend REST API) — P5.13 --------------------------
# Waitlist thank-you/notification mail + terminal-status run alerts go through
# Resend over plain httpx (no SDK). Fail-open + env-gated: send is a NO-OP unless
# EMAILS_ENABLED=1 AND RESEND_API_KEY is non-empty, and it never raises — a
# recorded signup/run is never lost to a mail failure.
#
# Master switch. 0 = OFF (default): no environment sends mail until you opt in.
EMAILS_ENABLED=0
# Resend API key (Bearer). Leave blank to keep email a no-op even if enabled.
RESEND_API_KEY=
# Operator address for new-signup + run alerts. Blank = those alerts are skipped.
NOTIFY_EMAIL=
# From address. MUST be a Resend-VERIFIED domain before real recipients get mail:
# the default onboarding@resend.dev is Resend "testing mode" and delivers ONLY to
# the Resend account owner, never to arbitrary recipients.
EMAIL_FROM=onboarding@resend.dev

# --- Worker -----------------------------------------------------------------
WORKER_POLL_SECONDS=2
STALE_CLAIM_SECONDS=300

# --- Dev host ports (deploy/docker-compose.yml only) ------------------------
# Host-side published ports for `make dev` / the dev compose file. Change these
# if the defaults collide with something already running on your machine
# (container-internal ports and inter-container URLs are unaffected).
YANKI_DB_PORT=5432
YANKI_API_PORT=8141
YANKI_WEB_PORT=8140

# --- Prod host ports (deploy/docker-compose.prod.yml only) -------------------
# Loopback binds the host nginx edge (deploy/nginx/yanki.beyondkaira.com.conf)
# proxies to; also used by deploy health checks / local debugging. Defaults
# dodge ports already in use on the beyondkaira VPS: 8140 belongs to another
# tenant, and 8141 is the dev stack's api default on the same box.
YANKI_PROD_WEB_PORT=8142
YANKI_PROD_API_PORT=8143
